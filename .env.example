# --- required ---

# == Telegram — from @BotFather ================================================================================================

TELEGRAM_BOT_TOKEN=

# == --- TTS (D-15) --- ========================================================================================================

TTS_BACKEND=elevenlabs       # elevenlabs | azure

# == ElevenLabs (eleven_multilingual_v2) — Free plan for build, Starter before the client link =================================

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# == Azure Neural (rollback) — free tier F0 ====================================================================================

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE_A=uk-UA-PolinaNeural
AZURE_VOICE_B=uk-UA-OstapNeural

# == --- STT (D-13) --- ========================================================================================================

# local | openai
STT_BACKEND=local

# local: path to the whisper.cpp binary
WHISPER_BIN=whisper-cli

# local: path to a ggml model (e.g. ggml-medium.bin)
WHISPER_MODEL=

# auto | uk | en
WHISPER_LANG=auto

# == --- dialogue LLM (D-13) --- ===============================================================================================

# gemini | ollama | openai
DIALOG_BACKEND=gemini

# gemini: gemini-flash-latest ; ollama: gemma4:cloud | glm-5.3-flash:cloud ; openai: gpt-4o-mini
DIALOG_MODEL=gemini-flash-latest

# default backend — from AI Studio (bundled with Google AI Pro)
GEMINI_API_KEY=

# DIALOG_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434

# == --- alternate / rollback --- ==============================================================================================

# STT_BACKEND=openai or DIALOG_BACKEND=openai
OPENAI_API_KEY=

# == --- misc --- ==============================================================================================================

KB_PATH=kb/translation-bureau.md
SYSTEM_PROMPT_PATH=prompt/system.md
DATA_DIR=./data
