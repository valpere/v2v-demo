# --- required ---

# == Telegram — from @BotFather ================================================================================================

TELEGRAM_BOT_TOKEN=

# == --- TTS (D-15) --- ========================================================================================================

TTS_BACKEND=azure            # none | elevenlabs | azure | espeak  (none = text-only replies)

# Optional runtime failover — "" (default, off) | elevenlabs | azure | espeak.
# When set, a TTS_BACKEND error retries once against this backend before the
# reply degrades to text-only. Same no-classification trade-off as the
# dialog/STT fallbacks below — see internal/tts/failover.go. espeak is the
# intended target: a free, local, robotic "spare tire" voice (espeak-ng
# formant synthesis) — fine for an outage, not a substitute for the primary
# day to day. Needs `espeak-ng` (ESPEAK_BIN below) + `ffmpeg` on PATH.
TTS_FALLBACK_BACKEND=

# == Azure Neural — LIVE default since 2026-09-15 (ElevenLabs subscription cancelled) ===========================================
# Free tier F0: 500k chars/mo, 12 mo. portal.azure.com → Speech service →
# Keys and Endpoint.

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE_A=uk-UA-PolinaNeural
AZURE_VOICE_B=uk-UA-OstapNeural

# == ElevenLabs (eleven_multilingual_v2) — CANCELLED 2026-09-15, kept for reference =============================================
# API key must have the "Text to Speech" permission (restrict the rest).
# On Free, the API rejects library voices (incl. UA ones) with 402 — only a
# subset of premade voices work. Verified on Free 2026-08-29:
#   Sarah (F) EXAVITQu4vr4xnSDxMaL · George (M) JBFqnCBsd6RMkjVDRZzb

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_A=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_B=JBFqnCBsd6RMkjVDRZzb

# == eSpeak NG — free, local, robotic. TTS_BACKEND=espeak or TTS_FALLBACK_BACKEND=espeak ========================================
# apt install espeak-ng. No key, no voice ids — one voice per language
# (uk / en-us), picked from the reply's detected language automatically.

ESPEAK_BIN=espeak-ng

# Shared by espeak (WAV->OGG) and STT_BACKEND=whispercpp below (OGG->WAV —
# whisper.cpp's own decoder can't read Opus/OGG directly).
FFMPEG_BIN=ffmpeg

# == --- STT (D-13) --- ========================================================================================================

# local (dev default — free, needs the openai-whisper CLI + ffmpeg on PATH) |
# openai (whisper-1 API — flip for the client sample recording; needs
# OPENAI_API_KEY + $5 prepay) | whispercpp (whisper.cpp's whisper-cli — see
# below, opt-in) | none (voice input disabled — a voice message gets a
# fixed "please type instead" reply, no download/transcribe attempted)
STT_BACKEND=local

# Optional runtime failover — "" (default, off) | local | openai | whispercpp.
# When set, a STT_BACKEND error retries once against this backend before
# degrading to the fixed "не розчув" line. No transient/permanent
# classification: ANY error triggers it, so a real outage costs the
# primary's own retry budget first (slower, not silent) — see
# internal/stt/failover.go. Must not be "none". Service-level protection
# only: all three backends run the SAME Whisper model lineage — this guards
# against the openai backend's API/network/quota being down, not against a
# Whisper mistranscription/hallucination pattern, which all would likely
# share.
STT_FALLBACK_BACKEND=

# local: the openai-whisper CLI (pipx install openai-whisper)
WHISPER_BIN=whisper

# local: openai-whisper model NAME — tiny | base | small | medium | large-v3 | turbo.
# Auto-downloads to ~/.cache/whisper on first use (~1.5 GB for turbo).
# turbo (= large-v3-turbo) is the default: faster than medium on CPU AND better
# Ukrainian — a 4-layer decoder distilled from large-v3. Drop to small for speed,
# large-v3 only if turbo quality is not enough.
WHISPER_MODEL=turbo

# auto | uk | en — Whisper's language for the FIRST voice turn only. After
# that the bot passes the conversation's detected language (lingua-go, D-19)
# as the hint, so a chat that started in English transcribes later voice as
# English regardless of this. Default uk: on short clips Whisper's own
# auto-detect drifts Ukrainian to Russian ("тиждень" -> "тыждынь"), and the
# model then mirrors that.
WHISPER_LANG=uk

# == whisper.cpp — opt-in, not the default (needs a manual build + downloaded model) ============================================
# STT_BACKEND=whispercpp or STT_FALLBACK_BACKEND=whispercpp. Build:
#   git clone https://github.com/ggml-org/whisper.cpp && cd whisper.cpp
#   cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --config Release -j$(nproc)
#   bash models/download-ggml-model.sh large-v3-turbo   # ~1.5 GB
# No Python/PyTorch — a single binary + one model file. Cannot decode
# Opus/OGG directly (confirmed against a real opus_48000_128 file), so this
# backend converts via FFMPEG_BIN first, same as espeak above.

WHISPER_CPP_BIN=whisper-cli
# Full path to a downloaded ggml .bin — REQUIRED when selected, no default.
WHISPER_CPP_MODEL_PATH=

# 0 (default) = omit -t, whisper-cli picks its own default. HOST-SENSITIVE —
# more threads is NOT automatically faster: measured on one machine, 4
# threads took 69.7s, 8 threads took 39.7s (best), 16 threads took 3m31s
# (severe contention) on the identical 102.6s clip. Benchmark on the actual
# target host before setting this; never assume nproc is the right value.
WHISPER_CPP_THREADS=0

# auto (default) | uk | en — NOT the same default as WHISPER_LANG=uk above.
# whisper-cli's own -l default is "en" if omitted (unlike openai-whisper's
# CLI, which auto-detects) — this stays "auto" so a first-turn hint of ""
# doesn't silently force English.
WHISPER_CPP_LANG=auto

# == --- dialogue LLM (D-13) --- ===============================================================================================

# ollama | openai | gemini
DIALOG_BACKEND=ollama

# Optional runtime failover — "" (default, off) | ollama | openai | gemini.
# When set, a DIALOG_BACKEND error retries once against this backend before
# the turn degrades to the fixed apology + escalate. Same no-classification
# trade-off as STT_FALLBACK_BACKEND above — see internal/dialog/failover.go.
DIALOG_FALLBACK_BACKEND=

# Blank → the backend's default (ollama gemma4:cloud, openai gpt-4.1-mini,
# gemini gemini-flash-latest). Set to override, e.g. ollama glm-5.3-flash:cloud.
DIALOG_MODEL=

# default backend — needs `ollama` logged in to a Pro/Max account
OLLAMA_BASE_URL=http://localhost:11434

# DIALOG_BACKEND=gemini — last resort, built but not fundable yet: the AI
# Studio project 429s ("prepayment credits depleted"). Fund + set this key
# before the client demo. Default model alias: gemini-flash-latest.
GEMINI_API_KEY=

# == --- alternate / rollback --- ==============================================================================================

# needed only for STT_BACKEND=openai (the client recording) or DIALOG_BACKEND=openai
OPENAI_API_KEY=

# == --- misc --- ==============================================================================================================

# The translation topic's files. Used directly only for the fallback
# synthetic topic (when TOPICS_PATH points at nothing); with the shipped
# topics/topics.json each topic names its own paths there.
KB_PATH=topics/translation/kb.md
SYSTEM_PROMPT_PATH=topics/translation/system.md
GREETING_PATH=topics/translation/greeting.md
DATA_DIR=./data

# IANA timezone for the bureau's local time — the "office hours" prompt block
# (Mon–Fri 09:00–18:00) is computed in this zone, NOT the server's. Set it if
# the host runs on UTC. Default: Europe/Kyiv.
BOT_TIMEZONE=Europe/Kyiv

# == --- session persistence --- ===============================================================================================

# memory (default — map[chatID]*Session, lost on restart) | sqlite (survives
# a restart; modernc.org/sqlite, no cgo)
SESSION_STORE=memory

# used only when SESSION_STORE=sqlite; parent dir is created if missing
SESSION_DB_PATH=./data/sessions.db

# == --- multi-topic (optional) --- =============================================================================================

# topics.json manifest — see topics/README.md. The repo ships one with five
# topics (translation, dental, auto, realestate, cleaning), so the
# inline-keyboard picker appears after /start by default. Each entry names
# its own kb/system_prompt/greeting/scope/slots/office. Point this at a
# single-entry file for no picker, or at nothing to fall back to a synthetic
# topic from KB_PATH/SYSTEM_PROMPT_PATH/GREETING_PATH above.
TOPICS_PATH=topics/topics.json
